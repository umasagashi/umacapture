// The web app (build/web/ on Workers Static Assets) together with the Worker for logins, record sharing and file sync.
//
// The top level is production: the assets at umacapture.com with the Worker in front of /r/*,
// /u/* and /api/*, its own D1 and its own Turnstile widget. env.staging is the same Worker on
// workers.dev with its own D1. wrangler.assets-only.jsonc deploys either one without the Worker.
//
// Deploy through tool/cloudflare/deploy_web.sh, never with a bare `wrangler deploy`: the script is
// what guarantees build/web/ was built from this commit in the same run. Use the wrangler pinned in
// server/package.json (server/node_modules/.bin/wrangler).
{
  "name": "umacapture-web",
  "main": "src/index.mjs",
  // No later than the newest date the pinned wrangler's local runtime accepts (4.113.0 accepts up
  // to 2026-07-28), so `wrangler dev` and the tests can run this config.
  "compatibility_date": "2026-07-28",
  // Usage metrics off for every command that reads this file. WRANGLER_SEND_METRICS, which
  // deploy_web.sh sets, takes precedence over this key.
  "send_metrics": false,
  "assets": {
    "directory": "../build/web",
    // Unknown paths answer 404. The app uses hash routing and serves nothing but "/", so a SPA
    // fallback would only turn every mistyped URL into a 73 MiB app download.
    "not_found_handling": "none",
    // The Worker runs first for these so a static file can never shadow an endpoint. Every other
    // path that matches no file still reaches the Worker, which answers it 404.
    "run_worker_first": ["/r/*", "/u/*", "/api/*"]
  },
  // Workers Logs off. env.staging inherits this.
  "observability": { "enabled": false },
  // The hourly run (src/scheduled.mjs), at half past every hour UTC: off the hour, and its 00:30 run
  // the first after sync's daily limits (limits.mjs, counted per UTC day) reset at 00:00 UTC. One
  // run hides at most 1,000 names (SYNC_LEFTOVER_HIDES), so hourly keeps what a cut-off request
  // leaves within hours of its hide.
  // env.staging sets its own, at a quarter to every hour, so the two never run at the same minute.
  "triggers": { "crons": ["30 * * * *"] },
  // The custom domain is the only entrance: the zone's WAF applies to it and to nothing else.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "umacapture.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "umacapture-share",
      // Created once with `wrangler d1 create umacapture-share`.
      "database_id": "4e8ae460-31b2-4a75-b340-c554e67e892a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://umacapture.com",
    // "static" gives every card /og/default.png; "vercel" points og:image at OG_IMAGE_ORIGIN.
    "OG_IMAGE_MODE": "vercel",
    "OG_IMAGE_ORIGIN": "https://og.umacapture.com",
    // "false" stops new logins and shares (503 sharing_paused); reads, unshares and logouts go on.
    "SHARING_ENABLED": "true",
    // The Managed widget for umacapture.com. Its secret, TURNSTILE_SECRET, is a Worker secret
    // (`wrangler secret put`), never a var.
    "TURNSTILE_SITEKEY": "0x4AAAAAAFPDypoYl2jLeU4y",
    // "false" refuses siteverify's answers for Turnstile's testing secrets.
    "TURNSTILE_TESTING_KEY": "false",
    // siteverify must report this hostname and action, or the login's begin is refused. The login
    // start page asks the widget for the same action.
    "TURNSTILE_HOSTNAME": "umacapture.com",
    "TURNSTILE_ACTION": "login",
    // The Google OAuth client of this environment. Empty until the client is created; a begin
    // refuses to run on an empty value rather than send Google an authorisation request without one.
    // Its secret, GOOGLE_CLIENT_SECRET, and IDENTITY_HMAC_KEY (32 random bytes as 64 lowercase hex
    // digits, the key identities are hashed under; losing it makes every account unreachable by its
    // login) are Worker secrets (`wrangler secret put`), never vars.
    "GOOGLE_CLIENT_ID": "",
    // The origin of the login callback, ${AUTH_REDIRECT_ORIGIN}/api/auth/callback/<provider>, as
    // registered with the provider. The authorisation request and the token exchange both build it.
    "AUTH_REDIRECT_ORIGIN": "https://umacapture.com",
    // "false" answers every endpoint under /api/sync/ 503 sync_paused; sharing and logins go on.
    "SYNC_ENABLED": "true",
    // The B2 bucket synced objects are stored in. Its key, B2_KEY_ID and B2_APPLICATION_KEY, is a
    // pair of Worker secrets (`wrangler secret put`), never vars.
    "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
    "B2_REGION": "us-west-004",
    "B2_BUCKET": "umacapture-sync"
  },

  "env": {
    // Served at umacapture-web-staging.<account subdomain>.workers.dev, with its own D1. Its Worker
    // and D1 usage is billed to the same account as production's.
    "staging": {
      "main": "src/index.mjs",
      // routes, workers_dev and assets are inherited from the top level unless set here; staging
      // must never claim the production domain.
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["45 * * * *"] },
      "assets": {
        "directory": "../build/web",
        "not_found_handling": "none",
        // The Worker runs first for these so a static file can never shadow an endpoint. Every
        // other path that matches no file still reaches the Worker, which answers it 404.
        "run_worker_first": ["/r/*", "/u/*", "/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "umacapture-share-staging",
          // Created once with `wrangler d1 create umacapture-share-staging`.
          "database_id": "b79b37f9-1beb-49ed-a144-1e1084d84146",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        // <worker name>-<env>.<account workers.dev subdomain>.workers.dev; tool/cloudflare/deploy_web.sh
        // verifies the staging deployment on the same origin.
        "PUBLIC_ORIGIN": "https://umacapture-web-staging.umasagashi.workers.dev",
        // Staging has no OGP image deployment of its own; its origin is decided if staging gets
        // its Worker back.
        "OG_IMAGE_MODE": "static",
        "OG_IMAGE_ORIGIN": "https://og-staging.invalid",
        // "false" stops new logins and shares (503 sharing_paused); reads, unshares and logouts go on.
        "SHARING_ENABLED": "true",
        // Turnstile's always-passing test sitekey: staging's login has no abuse protection.
        // The matching test secret, TURNSTILE_SECRET, is a Worker secret (`wrangler secret put`), never a var.
        "TURNSTILE_SITEKEY": "1x00000000000000000000AA",
        // "true" accepts siteverify's answers for the testing secret, which carry no hostname or
        // action of this environment. "false" refuses them; production must say "false".
        "TURNSTILE_TESTING_KEY": "true",
        // siteverify must report this hostname and action, or the login's begin is refused.
        "TURNSTILE_HOSTNAME": "umacapture-web-staging.umasagashi.workers.dev",
        "TURNSTILE_ACTION": "login",
        // Staging's own value: the top level's vars are not inherited once env.staging sets "vars".
        // Staging signs in through production's OAuth client, which also registers staging's
        // redirect URI, so this is production's client id.
        "GOOGLE_CLIENT_ID": "398895641600-5oqtrm01eo0j66qvne28dslqvq84bb2k.apps.googleusercontent.com",
        // Staging's own origin, so staging's logins come back to staging, where their rows are.
        "AUTH_REDIRECT_ORIGIN": "https://umacapture-web-staging.umasagashi.workers.dev",
        // "false" answers every endpoint under /api/sync/ 503 sync_paused; sharing and logins go on.
        "SYNC_ENABLED": "true",
        // Staging's own bucket, with its own key in the secrets B2_KEY_ID and B2_APPLICATION_KEY.
        "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
        "B2_REGION": "us-west-004",
        "B2_BUCKET": "umacapture-sync-staging"
      }
    }
  }
}
