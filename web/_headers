# Response headers Cloudflare Workers Static Assets attaches to every file under build/web/.
#
# COOP + COEP make the document cross-origin isolated on the FIRST load, which the -pthread
# recognition core needs for SharedArrayBuffer (web/worker.js refuses the session without it).
# With these present, coi-serviceworker.js sees `window.crossOriginIsolated` already true and
# returns before registering, so no service worker is installed on this origin at all.
# `require-corp`, not `credentialless`: it is the value coi-serviceworker.js itself uses in
# Chrome and Firefox, i.e. the condition the app has already been verified under.
#
# These headers only apply to responses served from static assets. A response a Worker script
# builds itself does not get them.
#
# Cache-Control is deliberately left at the platform default (max-age=0, must-revalidate, ETag):
# main.dart.js, worker.js, *.mjs and wasm/* have fixed names, so a long max-age would let an old
# script run against a new wasm module with nothing to notice it.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff

# The OGP function on Vercel fetches these fonts at run time (og/src/handler.mjs). They change
# only when their pin in tool/web_deps.json changes, and the function keeps a font that still
# parses, so a day of staleness after a pin change is harmless. A day and not `immutable`: the
# names carry no content hash.
/og/fonts/*
  Cache-Control: public, max-age=86400

# The public pages' font files, which tool/cloudflare/deploy_web.sh cuts out of M PLUS Rounded 1c at
# every deploy (web/site/site.css names them). A day and not `immutable`, for the same reason as
# above: the names carry no content hash. A day-old subset only lacks the characters a newer one
# added, and the browser draws those with a system font.
/site/fonts/*
  Cache-Control: public, max-age=86400
