# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/dist/

# Web related

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated files
lib/generated/
lib/*.g.dart

# Sandbox for developping
/sandbox/

# Runtime log written by the tracked addon test echo program (script is tracked,
# its log output is not). The integration test writes to a temp file instead.
/tool/addon_test/echo_log.txt

# Cloudflare credentials (real token/account id; scripts are tracked,
# the secrets file is not). Copy tool/cloudflare/.env.example to .env.
/tool/cloudflare/.env
# wrangler's local state and bundling scratch (`wrangler dev`, `wrangler deploy --dry-run`),
# written next to the config and in the working directory. tool/cloudflare/deploy_web.sh
# refuses a dirty tree, so these must not show up as untracked files.
.wrangler/
# Pointer/alias backups written by tool/cloudflare/publish_modules.sh.
/tool/cloudflare/.publish-backup/
# The share tables last deployed: the append-only baseline of tool/cloudflare/build_share_tables.py.
/tool/cloudflare/.deploy-backup/
# The sharing Worker's npm dependencies (pinned by server/package-lock.json, which is tracked) and
# its name tables, which are generated at deploy time from the module set and carry game text.
/server/node_modules/
/server/src/tables.generated.json
# The OGP image function's npm dependencies (pinned by og/package-lock.json, which is tracked) and
# the Vercel CLI's local project state.
/og/node_modules/
/og/.vercel/
# The Vercel token the OGP image function is deployed with (same convention as tool/cloudflare/.env).
/tool/vercel/.env

# FVM
.fvm/

/git-filter-repo

# Sentry native runtime artifacts
.sentry-native/

# Local working notes (kept out of version control)
.notes/
.codex/

# Local-only test material: the golden / dual-decode input clips, the accept ladder,
# the regression-grid and primary source recordings, and the live-capture harness's
# scratch roots. Large, machine-local and mostly irreproducible, so never committed --
# but referenced by name from cases.json and the harness scenarios, unlike .notes/.
testdata/

# Flutter test coverage output
coverage/

# Wasm recognition-core build outputs + vendored onnxruntime-web runtime.
# These are produced locally by native/wasm/build.sh (see native/wasm/README.md)
# and are treated like any other build artifact: each developer builds them
# locally, they are never committed. The coi-serviceworker shim in web/ is a
# tracked third-party vendored file and is intentionally NOT ignored here.
/web/wasm/

# M PLUS Rounded 1c, the public pages' font, and Noto Sans JP (about 16 MB together), served
# from web/ like the wasm runtime. The OGP image function fetches all three files from the origin: M PLUS
# for its text, Noto Sans JP for the characters M PLUS lacks. NotoSansJP-Bold.otf is read only by the
# earlier OG function still in production, and is served until the current one is deployed there.
# The public pages read woff2 subsets of
# M PLUS that tool/cloudflare/deploy_web.sh cuts out of it into build/web/site/fonts/.
# Pinned in tool/web_deps.json (provisioned_roots) and placed by tool/fetch_web_deps.py, so the
# web build stops when they are missing instead of shipping without them.
/web/og/fonts/
