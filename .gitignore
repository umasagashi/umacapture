# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/dist/

# Web related

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated files
lib/generated/
lib/*.g.dart

# Sandbox for developping
/sandbox/

# Runtime log written by the tracked addon test echo program (script is tracked,
# its log output is not). The integration test writes to a temp file instead.
/tool/addon_test/echo_log.txt

# Cloudflare R2 setup credentials (real token/account id; scripts are tracked,
# the secrets file is not). Copy tool/cloudflare/.env.example to .env.
/tool/cloudflare/.env

# FVM
.fvm/

/git-filter-repo

# Sentry native runtime artifacts
.sentry-native/

# Local working notes (kept out of version control)
.notes/
.codex/

# Flutter test coverage output
coverage/

# Wasm recognition-core build outputs + vendored onnxruntime-web runtime.
# These are produced locally by native/wasm/build.sh (see native/wasm/README.md)
# and are treated like any other build artifact: each developer builds them
# locally, they are never committed. The coi-serviceworker shim in web/ is a
# tracked third-party vendored file and is intentionally NOT ignored here.
/web/wasm/
