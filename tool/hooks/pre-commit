#!/usr/bin/env bash
# Reject commits that (a) ship web assets whose bytes no longer match their pins,
# (b) leave staged Dart files unformatted, or (c) introduce new raw color literals
# outside the theme.
#
# The page width is read from analysis_options.yaml (`formatter.page_width`), so
# this stays in sync with the project setting. Enable it once per clone with:
#
#   git config core.hooksPath tool/hooks
#
# Override the Dart executable via the DART env var if FVM lives elsewhere.
set -euo pipefail

DART="${DART:-.fvm/flutter_sdk/bin/dart}"

# Every gate below shells out to $DART, so a missing/unrunnable SDK would surface
# as exit 127/126 inside an `if !` and be reported as the gate's own failure
# ("web/ does not match ...") with nothing above it to explain. Say what is
# actually wrong, once, before any gate runs.
if ! command -v "$DART" > /dev/null 2>&1; then
  echo "✖ Dart SDK not found at: $DART" >&2
  echo "  Install the pinned SDK (see .fvmrc / .claude/CLAUDE.md), or point the hook" >&2
  echo "  at another one:  DART=/path/to/dart git commit ..." >&2
  exit 1
fi

# Block a commit whose web/ tree contradicts tool/web_deps.json. The committed
# assets/web_license_info.json claims those exact bytes are unmodified upstream;
# codegen is what enforces the claim, but a commit that skips codegen would carry
# the stale claim over the new bytes. Hashing the pinned files directly costs a
# couple of seconds, so the check runs on every commit rather than only when a
# web/ path is staged -- the artifact is committed, and it speaks for the whole
# tree, not just the staged part.
#
# SCOPE, DELIBERATELY: this verifies the WORKING TREE, not the staged content.
# `git add -p` / `git commit --only` can therefore commit bytes for a *tracked*
# pinned file (web/coi-serviceworker.js) that this check never saw. That residue
# is covered -- CI re-verifies the committed tree. What CI can never see is
# web/wasm/*, which is gitignored and exists only in the working tree, and that
# is precisely the tree this hook exists to speak for (see tool/build_web.sh's
# header for the same argument on the build path).
#
# --licenses keeps the hook exactly as strong as the artifact it defends: without
# it a commit that nulls a license.asset, adds a relocation_required block or
# points at a text that was never committed would pass here and only fail in CI.
#
# --warn-stale-source-digest IS A DELIBERATE HOLE, and the only one. The manifest
# pins the locally built web recognition core against a digest of the native/
# sources it was compiled from; every other consumer treats a mismatch as fatal.
# Here it only prints. Rebuilding that module needs an emsdk toolchain, so a
# fatal check would mean nobody without emsdk can commit a native/ change at all
# -- including native/ work that has nothing to do with the web build. The check
# still RUNS: when the pin is stale the check_web_pins run above prints what
# drifted and says CI will reject it, so the developer hears it here rather than
# only from a red CI run. Do not add this flag to tool/build_web.sh or to CI:
# those decide what ships, and there the stale pin must stay fatal.
#
# `status=$?` inside `if ! cmd` would read the *negated* status (always 0), so
# capture it on the command itself; `|| status=$?` also keeps `set -e` happy.
status=0
"$DART" run tool/check_web_pins.dart --licenses --warn-stale-source-digest || status=$?
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 127 ] || [ "$status" -eq 126 ]; then
    echo "" >&2
    echo "✖ Could not run '$DART run tool/check_web_pins.dart' (exit $status)." >&2
    echo "  This is a toolchain problem, not a pin mismatch. Resolve dependencies with:" >&2
    echo "    $DART pub get" >&2
    exit 1
  fi
  echo "" >&2
  echo "✖ web/ does not match tool/web_deps.json (see above)." >&2
  echo "  Restore the pinned bytes with:" >&2
  echo "    uv run tool/fetch_web_deps.py" >&2
  echo "  or, if the change is deliberate, update the pins in tool/web_deps.json" >&2
  echo "  and re-run: $DART run build_runner build --force-jit" >&2
  exit 1
fi

# `mapfile -t files < <(git ...)` would have discarded git's exit status: process
# substitution reports only what the *reader* did, so a git that failed (a broken
# index, a pathspec it rejected) produced an empty list, which reads exactly like
# "no Dart is staged" and skipped BOTH gates below with an exit 0. Take the list
# through a checked command substitution instead, so "git could not answer" and
# "the answer is nothing" stay distinguishable.
staged_status=0
# ACMR, not ACM: git reports a moved-and-edited file as a single `R` entry (its
# similarity index over the default ~50% threshold), never split into an `A` +
# `D` pair -- a low-similarity rewrite lands as `A`+`D` and `A` alone already
# satisfies this filter, so `R` is the only status this list was missing. With
# `ACM` a `git mv` plus an edit (e.g. a colour literal added at the new path)
# made `staged` empty, which read as "no Dart staged" and skipped the format
# and colour gates for the entire commit -- see the rename case in
# test_pre_commit.sh. `--name-only` on an `R` entry prints only the
# destination path, which is exactly the path `dart format` and the diff below
# need to read.
staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')" || staged_status=$?
if [ "$staged_status" -ne 0 ]; then
  echo "" >&2
  echo "✖ Could not list the staged Dart files (git exit $staged_status)." >&2
  echo "  The format and color-literal gates below cannot run, so this commit is" >&2
  echo "  refused rather than passed unchecked." >&2
  exit 1
fi
files=()
while IFS= read -r staged_file; do
  [ -n "$staged_file" ] && files+=("$staged_file")
done <<< "$staged"
if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

if ! "$DART" format --output=none --set-exit-if-changed "${files[@]}"; then
  echo "" >&2
  echo "✖ Staged Dart files are not formatted. Run:" >&2
  echo "    $DART format ${files[*]}" >&2
  echo "  then re-stage and commit." >&2
  exit 1
fi

# Block *newly added* raw color literals. New code must read colors from the
# theme: ColorScheme roles, or the AppSemanticColors / AppChartColors /
# CodeHighlightColors extensions in lib/src/gui/theme_extensions.dart. Only added
# lines are scanned, so pre-existing literals awaiting migration are grandfathered.
#
# Allowlist: files that legitimately hold the canonical literals.
color_allowlist=(
  "lib/src/gui/theme_extensions.dart"
  "lib/src/gui/theme_gallery.dart"
)
# Word-boundary on Colors/Color so identifiers like `AppSemanticColors.light`
# or `ColoredBox` are not mistaken for the Flutter `Colors` / `Color` APIs.
# Only literal colors are blocked; alpha applied to a theme role
# (e.g. `colorScheme.scrim.withValues(alpha: .3)`) is allowed, while literal
# alpha (`Colors.black.withValues(...)`) is still caught by the `Colors.` rule.
# `Colors.transparent` is structural ("no color", no theme role exists) and is
# stripped before matching so it is not flagged. The strip stops at a following
# `.`, because the exemption is for the *value*, not for the name as a prefix:
# `Colors.transparent.withValues(alpha: 1)` is opaque black, i.e. a literal
# colour wearing the exempt spelling, and stripping it unconditionally handed the
# whole `Colors.` rule an escape hatch spelled in eighteen characters.
#
# THE THREE ALTERNATIVES ARE SHAPES, NOT A LIST OF SPELLINGS, because a list of
# spellings is what let `Color.fromARGB` -- the form Flutter's own docs reach for
# first -- through a hook written to stop exactly that:
#   1. `Colors.<anything>`: the Material palette, whatever the swatch is called.
#   2. `Color(<digit>`: the default constructor over a numeric literal. The class
#      is `[0-9]`, not the character `0`: writing `0` was meant to cover "0x, 0X
#      and plain decimal alike", but a decimal ARGB does not begin with a zero --
#      `Color(4278190080)` walked straight through the gate that comment claimed
#      covered it. Let the machine enumerate the digits instead of hand-picking
#      one; no identifier can begin with a digit, so nothing that is not a
#      literal matches. `[[:space:]]*` because `Color( 0xFF…)` is the same
#      literal (`dart format` would close the gap, but the gate must not depend
#      on a gate that runs beside it).
#   3. `Color.from…` (and the HSL/HSV builders): every named constructor that
#      builds a colour out of component numbers is spelled `from<something>`.
#      `Color.lerp` and the rest are deliberately NOT matched -- they take colours
#      rather than digits, so their inputs are caught wherever those came from.
color_pattern='\bColors\.|\bColor\([[:space:]]*[0-9]|\b(Color|HSLColor|HSVColor)\.from'

violations=""
for f in "${files[@]}"; do
  for allowed in "${color_allowlist[@]}"; do
    [ "$f" = "$allowed" ] && continue 2
  done
  # Added lines only: drop the '+++' header, keep '+' lines, strip the leading '+'.
  #
  # One `sed -n` rather than the `grep -E '^\+' | grep -vE '^\+\+\+' | sed` pipeline
  # this replaces. Every `grep` stage answered 1 for "no added lines" and 2 for "I
  # could not run", and under `pipefail` a leading stage's 2 is masked by the
  # trailing stage's 1 -- so the pipeline had no honest status left to test, and the
  # `|| true` on the end made that moot anyway. `sed -n` has no such overload:
  # printing nothing is not an error. That leaves `git diff` as the only step here
  # that can fail, and it is now checked on a line of its own.
  diff_status=0
  diff_out="$(git diff --cached -U0 -- "$f")" || diff_status=$?
  if [ "$diff_status" -ne 0 ]; then
    echo "" >&2
    echo "✖ Could not read the staged diff for $f (git exit $diff_status)." >&2
    echo "  The color-literal check cannot run, so this commit is refused rather" >&2
    echo "  than passed unchecked." >&2
    exit 1
  fi
  added="$(printf '%s\n' "$diff_out" | sed -nE '/^[+][+][+]/d; s/^[+]//p')"
  scrubbed="$(printf '%s\n' "$added" | sed -E 's/\bColors\.transparent($|[^.])/\1/g')"

  # `grep` answers 0 = matched, 1 = matched nothing, 2 = the run itself failed --
  # most plausibly because `color_pattern` above stopped being a valid POSIX ERE.
  # `|| true` collapsed all three into "matched nothing": with a broken pattern grep
  # printed `grep: Unmatched ( or \(` and the hook still exited 0, so the gate was
  # off while every commit still looked clean. A check that cannot run must not be
  # allowed to answer "nothing found" -- keep the three outcomes apart and stop on
  # the third.
  grep_status=0
  hits="$(grep -E "$color_pattern" <<< "$scrubbed")" || grep_status=$?
  if [ "$grep_status" -gt 1 ]; then
    echo "" >&2
    echo "✖ The color-literal check could not run (grep exit $grep_status; see above)." >&2
    echo "  color_pattern in tool/hooks/pre-commit is not a valid POSIX ERE, so the" >&2
    echo "  gate is off. Fix the pattern; do not commit around it." >&2
    exit 1
  fi
  if [ -n "$hits" ]; then
    violations+="  $f:"$'\n'
    while IFS= read -r line; do
      [ -n "$line" ] && violations+="    ${line#"${line%%[![:space:]]*}"}"$'\n'
    done <<< "$hits"
  fi
done

if [ -n "$violations" ]; then
  echo "" >&2
  echo "✖ New raw color literals are not allowed. Read colors from the theme" >&2
  echo "  (ColorScheme roles, or the *Colors ThemeExtensions in" >&2
  echo "  lib/src/gui/theme_extensions.dart) instead:" >&2
  echo "" >&2
  printf '%s' "$violations" >&2
  exit 1
fi
