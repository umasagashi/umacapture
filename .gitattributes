# Flutter regenerates these on every `flutter pub get` / build, writing LF line
# endings. Without a rule, core.autocrlf rewrites the working copy to CRLF and
# git reports a spurious (content-identical) diff after each build. Pin them to
# LF so regeneration matches the committed blob and produces no EOL-only churn.
windows/flutter/generated_plugin_registrant.* eol=lf
windows/flutter/generated_plugins.cmake       eol=lf

# build_runner / auto_route / distribution_info regenerate these with LF too.
# Same rationale as above: pin to LF so codegen produces no EOL-only churn.
*.mapper.dart                                  eol=lf
*.gr.dart                                      eol=lf
lib/distribution_info.dart                     eol=lf
assets/license_info.json                       eol=lf
assets/version_info.json                       eol=lf
assets/web_license_info.json                   eol=lf
assets/additional_license_info.json            eol=lf

# The flutter-ai-rules-sync skill regenerates this vendored rules file with LF.
# Same rationale as above: pin to LF so re-syncing produces no EOL-only churn.
.claude/rules/flutter-ai-rules.md              eol=lf

# Git hooks are executed by bash (Git for Windows). With core.autocrlf=true a
# fresh clone would write CRLF, and a `#!/usr/bin/env bash\r` shebang fails to
# run. Pin to LF so the hook stays executable on Windows.
tool/hooks/pre-commit                          eol=lf

# Same shebang trap for the shell scripts run directly from a skill runbook.
# The `**` is required: a pattern containing a slash is path-anchored and a plain
# `*` does not match `/`, so `tool/*.sh` would leave tool/cloudflare/*.sh CRLF.
tool/**/*.sh                                   eol=lf

# Same shebang trap for the wasm PoC build script, which is run with bash.
native/wasm/*.sh                               eol=lf

# Same shebang trap for the copied OpenCV-toolchain scripts. They are kept as a
# reproduction record rather than run routinely, but the one occasion they are
# needed is the one where the toolchain has to be rebuilt from nothing, so a
# CRLF shebang would fail exactly then.
docs/wasm-toolchain/*.sh                       eol=lf

# Pinned byte-for-byte in tool/web_deps.json (it is a verbatim upstream release
# file). With core.autocrlf=true a fresh clone would check it out as CRLF, so its
# SHA-256 would no longer match the pin and tool/fetch_web_deps.py would report
# drift and overwrite this tracked file. Pin to LF so the checkout matches upstream.
web/coi-serviceworker.js                       eol=lf

# The native CLI's `build` subcommand regenerates these scene definitions (io_util::write in
# native/src/util/misc.h, which opens the stream in binary mode so the CRT cannot inject CR).
# Pin to LF so regeneration matches the committed blob on every platform.
assets/config/chara_detail/recognizer.json     eol=lf
assets/config/chara_detail/scene_context.json  eol=lf
assets/config/chara_detail/scene_scraper.json  eol=lf
assets/config/chara_detail/scene_stitcher.json eol=lf

# `flutter create` / the Visual Studio Windows-runner template wrote these with
# CRLF; we did not generate them. Pin to LF so a fresh clone matches the
# committed blob and doesn't report spurious CRLF diffs. Pin each path on its
# own: windows/runner/ also holds Runner.rc and main.cpp, which are already LF
# here and are not part of this set, and a glob would silently take them over.
.metadata                                         eol=lf
analysis_options.yaml                             eol=lf
android/app/src/main/res/values-night/styles.xml  eol=lf
android/app/src/main/res/values/styles.xml        eol=lf
android/gradle.properties                         eol=lf
windows/flutter/CMakeLists.txt                    eol=lf
windows/runner/resource.h                         eol=lf
windows/runner/runner.exe.manifest                eol=lf
windows/runner/utils.cpp                          eol=lf
windows/runner/utils.h                            eol=lf
windows/runner/win32_window.h                     eol=lf

# native/.gitignore is hand-written, not template-derived, but was also checked
# out CRLF; pinned separately (not lumped with the template group above) so the
# comment above stays accurate if this file's origin is ever revisited.
native/.gitignore                                 eol=lf
